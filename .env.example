# ============================================================
# Defrag — Environment Variables
# Copy this to .env and fill in your values.
# NEVER commit .env to git.
# ============================================================

# ============================================================
# LLM (required for real AI reasoning; rule-based fallback if missing)
# ============================================================

# Google Gemini (recommended)
# Get from: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# OpenAI (alternative to Gemini)
# Get from: https://platform.openai.com/api-keys
# OPENAI_API_KEY=sk-your_openai_key_here

# Model override (optional)
# LLM_MODEL=gemini-1.5-flash

# ============================================================
# AWS (optional — uses simulated dataset if missing)
# Required permissions: ec2:Describe*, ec2:StopInstances (DryRun),
#   rds:Describe*, lambda:List*, s3:ListBuckets, cloudwatch:GetMetricStatistics
# ============================================================

AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_DEFAULT_REGION=us-east-1

# Needed to stop instances (requires ec2:StopInstances permission)
# AWS_ACCOUNT_ID=123456789012

# ============================================================
# GITHUB (optional — enables project context enrichment)
# Get from: https://github.com/settings/tokens
# Required scopes: read:user, public_repo (or repo for private)
# ============================================================

GITHUB_TOKEN=ghp_your_github_pat_here

# ============================================================
# STRIPE (optional — enables subscription discovery)
# Use a test key (sk_test_...) for safe testing
# ============================================================

STRIPE_API_KEY=sk_test_your_stripe_key_here

# ============================================================
# RENDER (optional — enables Render service discovery)
# Get from: https://dashboard.render.com/u/<user>/account/api-keys
# ============================================================

RENDER_API_KEY=rnd_your_render_key_here

# ============================================================
# GCP (optional — enables GCP Compute discovery)
# ============================================================

# GCP_PROJECT_ID=your-gcp-project-id
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json

# ============================================================
# DATABASE (optional — SQLite used by default)
# PostgreSQL example: postgresql://user:pass@localhost:5432/defrag_db
# ============================================================

# DATABASE_URL=sqlite:///./defrag.db

# ============================================================
# APP
# ============================================================

PORT=8000
